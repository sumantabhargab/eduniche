# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Content CMS ───────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTENT_BUCKET=eduniche-content

# ─── AI ────────────────────────────────────────────────────────────────────
# Groq API key — SERVER ONLY, never expose to client
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile

# ─── Payments ─────────────────────────────────────────────────────────────
# Razorpay — public key can be in NEXT_PUBLIC
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
# Razorpay secret — SERVER ONLY
RAZORPAY_KEY_SECRET=your-razorpay-secret
# Razorpay webhook secret — SERVER ONLY
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── Virtual Library Feature Flags ─────────────────────────────────────────
NEXT_PUBLIC_VIRTUAL_LIBRARY_ENABLED=true
NEXT_PUBLIC_VIRTUAL_LIBRARY_VIDEO=false
NEXT_PUBLIC_VIRTUAL_LIBRARY_CHAT=true
NEXT_PUBLIC_VIRTUAL_LIBRARY_AI=false
