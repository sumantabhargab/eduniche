<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Allow file sharing from app's files directory -->
    <files-path
        name="shared_files"
        path="." />

    <!-- Allow file sharing from cache directory -->
    <cache-path
        name="cache_files"
        path="." />

    <!-- Allow file sharing from external files directory -->
    <external-path
        name="external_files"
        path="." />

    <!-- Allow sharing downloaded files -->
    <external-files-path
        name="external_download"
        path="Download/" />
</paths>
